---
// トップページのファーストビューに出す、ロゴの設計図（dgdgdgdg_logo_blueprint.svg のロゴのまわり）
// 座標は設計図のまま。方眼の 1 目盛（14.173）が A/2、2 目盛が A
// 設計図の方眼は図面の枠から始まっていて、縦の向きがロゴとずれているので、ロゴに合わせて敷き直す
// 段階（data-stage）は親の .hero に付け、スクリプトはトップページ側に置く
//   0: 方眼だけ / 1: 補助線とラベル / 2: ロゴの輪郭と斜線 / 3: 寸法と比 / 4: べた塗り

/** 線（始点と終点） */
type Line = [x1: number, y1: number, x2: number, y2: number];

/** 文字（位置・回転・文字の揃え・ずらす量） */
interface Label {
  text: string;
  x: number;
  y: number;
  rotate?: number;
  anchor?: 'start' | 'middle' | 'end';
  dy?: number;
  /** 線の上に重ねる小さい文字は、背景色の縁取りで下の線を隠す */
  knockout?: boolean;
  size?: number;
}

// 補助線（縦 X1〜X21、横 Y1〜Y7）
const xs = [
  197.4, 255.1, 283.5, 297.6, 326, 397.9, 455.6, 483.9, 498.1, 526.4, 598.3, 656, 684.3, 698.5, 726.9, 798.7, 856.4,
  884.8, 899, 927.3, 999.2,
];
const ys = [827.7, 787.6, 749, 727.5, 720.6, 627.3, 613.1];
const verticals: Line[] = xs.map((x) => [x, 570.6, x, 870.2]);
const horizontals: Line[] = ys.map((y) => [154.9, y, 1041.7, y]);

// 45° の補助線（一点鎖線）。U は左下から右上へ、V は左上から右下へ引く
const diagonalsU: Line[] = [
  [154.9, 770, 354.3, 570.6],
  [255.1, 870.2, 554.8, 570.5],
  [455.6, 870.2, 755.3, 570.5],
  [656, 870.2, 955.7, 570.5],
  [856.4, 870.2, 1041.7, 684.9],
];
const diagonalsV: Line[] = [
  [154.9, 685, 340.2, 870.3],
  [240.9, 570.6, 540.6, 870.3],
  [441.4, 570.6, 741.1, 870.3],
  [641.8, 570.6, 941.5, 870.3],
  [842.3, 570.6, 1041.7, 770],
];

const constructionLabels: Label[] = [
  ...xs.map((x, i) => ({ text: `X${i + 1}`, x, y: 567.2, anchor: 'middle' as const })),
  ...ys.map((y, i) => ({ text: `Y${i + 1}`, x: 152.6, y: y + 2.2, anchor: 'end' as const })),
  ...diagonalsU.slice(0, 4).map(([, , x2], i) => ({ text: `U${i + 1}`, x: x2, y: 567.2, anchor: 'middle' as const })),
  { text: 'U5', x: 1044.5, y: 687.2 },
  { text: 'V1', x: 152.6, y: 687.2, anchor: 'end' },
  ...diagonalsV.slice(1).map(([x1], i) => ({ text: `V${i + 2}`, x: x1, y: 567.2, anchor: 'middle' as const })),
];

// 寸法線
const dimensionLines: Line[] = [
  // 上の A・A/2・A（4 つの dg ごと）
  ...[255.1, 455.6, 656, 856.4].flatMap((x): Line[] => [
    [x, 584.8, x + 28.4, 584.8],
    [x + 28.4, 584.8, x + 42.5, 584.8],
    [x + 42.5, 584.8, x + 70.9, 584.8],
  ]),
  // 右の A・A/2
  [1027.5, 749, 1027.5, 720.7],
  [1027.5, 627.3, 1027.5, 613.1],
  // ロゴの中の A
  [226.3, 756.3, 246.3, 736.3],
  [498.1, 703.2, 526.4, 703.2],
  [537.6, 706.9, 557.6, 686.9],
  [714.1, 749, 714.1, 720.7],
  [717.8, 768.3, 737.8, 788.3],
  // 5A
  [1021.9, 704.8, 921.7, 604.6],
  [924.5, 853.2, 1024.7, 753],
];

const dimensionLabels: Label[] = [
  ...[255.1, 455.6, 656, 856.4].flatMap((x): Label[] => [
    { text: 'A', x: x + 14.2, y: 582.2, anchor: 'middle', size: 6.8 },
    { text: 'A/2', x: x + 35.5, y: 582.2, anchor: 'middle', size: 5.4 },
    { text: 'A', x: x + 56.7, y: 582.2, anchor: 'middle', size: 6.8 },
  ]),
  { text: 'A', x: 1025.2, y: 734.8, rotate: -90, anchor: 'middle' },
  { text: 'A/2', x: 1025.2, y: 620.2, rotate: -90, anchor: 'middle', size: 5.1 },
  { text: 'A', x: 236.3, y: 746.3, rotate: -45, anchor: 'middle', dy: 2, knockout: true, size: 5.7 },
  { text: 'A', x: 512.3, y: 703.2, anchor: 'middle', dy: 2, knockout: true, size: 5.7 },
  { text: 'A', x: 547.6, y: 696.9, rotate: -45, anchor: 'middle', dy: 2, knockout: true, size: 5.7 },
  { text: 'A', x: 714.1, y: 734.9, rotate: -90, anchor: 'middle', dy: 2, knockout: true, size: 5.7 },
  { text: 'A', x: 727.8, y: 778.3, rotate: 45, anchor: 'middle', dy: 2, knockout: true, size: 5.7 },
  { text: '5A', x: 971.8, y: 654.7, rotate: 45, anchor: 'middle', dy: -2.5, size: 6.8 },
  { text: '5A', x: 974.6, y: 803.1, rotate: -45, anchor: 'middle', dy: 7.4, size: 6.8 },
  { text: '45°', x: 278.3, y: 868.5, size: 6.8 },
];

// ロゴ（d と g の組を 4 つ）。輪郭は外形と穴に分けて引き、べた塗りは 1 本のパスにまとめて穴を抜く
const offsets = [0, 200.45, 400.9, 601.3];
const shapes = offsets.flatMap((dx) => [
  {
    outer: `M${283.5 + dx},613.1h-28.3v56.7l-57.7,57.7,86,86v-200.4Z`,
    hole: `M${255.1 + dx},745.1v-35.2l-17.6,17.6,17.6,17.6Z`,
  },
  {
    outer: `M${297.6 + dx},627.3v121.7h38.7l-38.7,38.7v40.1l100.2-100.2-100.2-100.2Z`,
    hole: `M${326 + dx},720.6h24.9l-24.9-24.9v24.9Z`,
  },
]);
const logoPath = shapes.map(({ outer, hole }) => outer + hole).join('');

const labelAttrs = ({ x, y, rotate, anchor, dy, size }: Label) => ({
  transform: `translate(${x} ${y})${rotate ? ` rotate(${rotate})` : ''}`,
  'text-anchor': anchor ?? 'start',
  dy,
  'font-size': size,
});
---

<svg
  class="blueprint"
  viewBox="127.6 544.2 935.4 340.2"
  role="img"
  aria-label="dgdgdgdg"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- 方眼はロゴの左上の角（X2・Y7）から始め、ロゴの縦線・上端と方眼の線をそろえる -->
    <pattern id="bp-grid" patternUnits="userSpaceOnUse" x="255.1" y="613.1" width="14.1732" height="14.1732">
      <path d="M0,0H14.1732M0,0V14.1732" class="bp-grid-line"></path>
    </pattern>
    <pattern id="bp-hatch" patternUnits="userSpaceOnUse" x="0" y="0" width="5" height="5">
      <path d="M-1.25,1.25l2.5-2.5M0,5l5-5M3.75,6.25l2.5-2.5" class="bp-hatch-line"></path>
    </pattern>
  </defs>

  <g class="bp-camera">
    <!-- 方眼は画面いっぱいに敷く（svg の外も overflow: visible で見せる） -->
    <rect class="bp-grid" x="-4000" y="-3000" width="9000" height="7000" fill="url(#bp-grid)"></rect>

    <g class="bp-construction">
      {
        [...horizontals, ...verticals].map(([x1, y1, x2, y2], i) => (
          <path class="bp-draw" d={`M${x1},${y1}L${x2},${y2}`} pathLength="1" style={`--i: ${i}`} />
        ))
      }
      {
        diagonalsU.map(([x1, y1, x2, y2], i) => (
          <path class="bp-chain bp-chain--up" d={`M${x1},${y1}L${x2},${y2}`} style={`--i: ${i}`} />
        ))
      }
      {
        diagonalsV.map(([x1, y1, x2, y2], i) => (
          <path class="bp-chain bp-chain--down" d={`M${x1},${y1}L${x2},${y2}`} style={`--i: ${i}`} />
        ))
      }
      <g class="bp-labels">
        {constructionLabels.map((label) => <text {...labelAttrs(label)}>{label.text}</text>)}
      </g>
    </g>

    <g class="bp-logo-sketch">
      <path class="bp-hatch" d={logoPath} fill="url(#bp-hatch)" fill-rule="evenodd"></path>
      {
        shapes.flatMap(({ outer, hole }, i) => [
          <path class="bp-outline" d={outer} pathLength="1" style={`--i: ${i}`} />,
          <path class="bp-outline" d={hole} pathLength="1" style={`--i: ${i}`} />,
        ])
      }
    </g>

    <g class="bp-dimensions">
      {
        dimensionLines.map(([x1, y1, x2, y2], i) => (
          <path class="bp-draw" d={`M${x1},${y1}L${x2},${y2}`} pathLength="1" style={`--i: ${i}`} />
        ))
      }
      <path class="bp-draw" d="M297.6,863.1c-9.4,0-18.4-3.7-25.1-10.4" pathLength="1" style="--i: 0"></path>
      <path class="bp-arrow" d="M297.6,863.1l-4.3,1.2v-2.4l4.3,1.2ZM272.6,852.8l3.8,2.2-1.7,1.7-2.2-3.8Z"></path>
      <g class="bp-labels">
        {
          dimensionLabels.map((label) => (
            <text class:list={[{ 'bp-knockout': label.knockout }]} {...labelAttrs(label)}>
              {label.text}
            </text>
          ))
        }
      </g>
    </g>

    <path class="bp-logo" d={logoPath} fill-rule="evenodd"></path>
  </g>
</svg>

<style lang="sass">
  // 段階ごとの見た目は、親の .hero に付けた data-stage で切り替える
  // 段階を戻すときも同じ transition で逆に動く
  .blueprint
    --bp-ease: cubic-bezier(0.65, 0, 0.35, 1)
    display: block
    width: min(92vw, 1400px)
    height: auto
    overflow: visible

    path, rect, text
      transition-timing-function: var(--bp-ease)

  // スマホでは描いている間、最初の dg に寄せて大きく見せ、べた塗りのときに全体へ引く
  .bp-camera
    transform-box: view-box
    transform-origin: 297.6px 714.3px
    transition: transform 0.9s var(--bp-ease)

  @media (max-width: 768px)
    :global(.hero:not([data-stage='4'])) .bp-camera
      transform: translate(297.7px, 0) scale(3)

  .bp-grid
    transition: opacity 0.6s

  .bp-grid-line
    fill: none
    stroke: var(--c-black-a8)
    stroke-width: 0.4

  // 線を伸ばして描く（pathLength を 1 にして、破線の長さとずれで隠す）
  .bp-draw
    fill: none
    stroke: var(--c-gray-400)
    stroke-width: 0.5
    stroke-dasharray: 1 1
    stroke-dashoffset: 1
    transition: stroke-dashoffset 0.7s calc(var(--i) * 18ms), opacity 0.5s

  // 一点鎖線は破線の模様を使っているので、切り抜く範囲を広げて描く
  .bp-chain
    fill: none
    stroke: var(--c-gray-400)
    stroke-width: 0.6
    stroke-dasharray: 11.3 2.8 1.7 2.8
    transition: clip-path 0.8s calc(0.35s + var(--i) * 60ms), opacity 0.5s

  .bp-chain--up
    clip-path: inset(100% 100% 0 0)

  .bp-chain--down
    clip-path: inset(0 100% 100% 0)

  .bp-labels
    opacity: 0
    fill: var(--c-gray-800)
    font-family: var(--font-latin)
    font-size: 6.2px
    transition: opacity 0.5s

  .bp-knockout
    paint-order: stroke
    stroke: var(--c-white)
    stroke-width: 3

  .bp-outline
    fill: none
    stroke: var(--c-black)
    stroke-width: 1.3
    stroke-linejoin: miter
    stroke-dasharray: 1 1
    stroke-dashoffset: 1
    transition: stroke-dashoffset 0.9s calc(var(--i) * 50ms), opacity 0.5s

  .bp-hatch
    opacity: 0
    transition: opacity 0.6s

  .bp-hatch-line
    fill: none
    stroke: var(--c-gray-800)
    stroke-width: 0.6

  .bp-arrow
    opacity: 0
    fill: var(--c-gray-400)
    transition: opacity 0.4s

  .bp-dimensions
    .bp-draw
      transition: stroke-dashoffset 0.6s calc(var(--i) * 25ms), opacity 0.5s

  .bp-logo
    opacity: 0
    fill: var(--c-accent)
    transition: opacity 0.6s 0.2s

  // 1: 補助線とラベル
  :global(.hero[data-stage='1']),
  :global(.hero[data-stage='2']),
  :global(.hero[data-stage='3'])
    .bp-construction .bp-draw
      stroke-dashoffset: 0
    .bp-chain
      clip-path: inset(0)
    .bp-construction .bp-labels
      opacity: 1
      transition-delay: 0.4s

  // 2: ロゴの輪郭と斜線
  :global(.hero[data-stage='2']),
  :global(.hero[data-stage='3'])
    .bp-outline
      stroke-dashoffset: 0
    .bp-hatch
      opacity: 1
      transition-delay: 0.6s

  // 3: 寸法と比
  :global(.hero[data-stage='3'])
    .bp-dimensions .bp-draw
      stroke-dashoffset: 0
    .bp-arrow,
    .bp-dimensions .bp-labels
      opacity: 1
      transition-delay: 0.4s

  // 4: 方眼・補助線・寸法を消し、ロゴをべた塗りにする
  :global(.hero[data-stage='4'])
    .bp-grid,
    .bp-construction,
    .bp-logo-sketch,
    .bp-dimensions
      opacity: 0
    .bp-construction .bp-draw,
    .bp-outline,
    .bp-dimensions .bp-draw
      stroke-dashoffset: 0
    .bp-chain
      clip-path: inset(0)
    .bp-hatch,
    .bp-arrow,
    .bp-labels
      opacity: 1
    .bp-logo
      opacity: 1

  .bp-construction,
  .bp-logo-sketch,
  .bp-dimensions
    transition: opacity 0.5s

  // 途中の位置で開き直したときは、その段階の状態をそのまま出す
  :global(.hero.is-instant) *
    transition: none !important

  @media (prefers-reduced-motion: reduce)
    .blueprint *
      transition-duration: 0s !important
      transition-delay: 0s !important
</style>
