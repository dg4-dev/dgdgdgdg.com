---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import Phrase from './Phrase.astro';

export interface Props {
  title: string;
  createdDate?: string;
  /** 作品の短い説明（任意） */
  summary?: string;
  categories?: { name: string; color: string }[];
  coverImageUrl?: string;
  isPrivate: boolean;
  /** 指定時は <a> でラップ、未指定時は <article>（プライベート作品・詳細ページがない作品） */
  href?: string;
  /** true のとき、href を新しいタブで開く（外部リンク） */
  external?: boolean;
  /** works ページのフィルタ/ソート用。指定時のみ data-work-* を付与 */
  dataWorkTitle?: string;
  dataWorkDate?: string;
  dataWorkCategories?: string;
  /** works ページの絞り込み用。このサイトの中に詳細ページがあるか（外部リンクは含めない） */
  dataWorkArticle?: boolean;
}

const {
  title,
  createdDate = '',
  summary = '',
  categories = [],
  coverImageUrl = '',
  isPrivate,
  href,
  external = false,
  dataWorkTitle,
  dataWorkDate,
  dataWorkCategories,
  dataWorkArticle = false,
} = Astro.props;

// プライベート作品とカバー画像がない作品には、代わりの画像（No Image）を出す
const NO_IMAGE_SRC = '/images/no-image.png';
const showsNoImage = isPrivate || !coverImageUrl;
const coverSrc = showsNoImage ? NO_IMAGE_SRC : coverImageUrl;
// 代わりの画像はどの作品でも同じなので、alt を空にして読み上げでは読まない（非公開であることは文字で伝える）
const coverAlt = showsNoImage ? '' : title;
const hasDataAttrs = dataWorkTitle !== undefined;

// リンクのときは <a>、リンクなし（プライベート作品）のときは <article> で中身は共通
const Tag = href ? 'a' : 'article';
const linkAttrs = href ? { href, ...(external && { target: '_blank', rel: 'noopener noreferrer' }) } : {};
const dataAttrs = hasDataAttrs
  ? {
      'data-work-title': dataWorkTitle,
      'data-work-date': dataWorkDate ?? '',
      'data-work-private': String(isPrivate),
      'data-work-categories': dataWorkCategories ?? '',
      'data-work-article': String(dataWorkArticle),
    }
  : {};
---

<Tag class:list={['work-card', { 'work-card--link': href }]} {...linkAttrs} {...dataAttrs}>
  <div class="work-cover">
    <Image src={coverSrc} alt={coverAlt} width={520} height={390} loading="lazy" />
  </div>
  <div class="work-content">
    <h2 class="work-card-title">
      <Phrase text={title} />
      {/* リンク先の印。詳細ページは右向き、外部リンクは右上向き。リンクのないカードには出さない */}
      {
        href &&
          (external ? (
            <>
              <ArrowUpRight class="work-link-icon" size={14} />
              <span class="visually-hidden">（新しいタブで開きます）</span>
            </>
          ) : (
            <ArrowRight class="work-link-icon" size={14} />
          ))
      }
    </h2>
    {createdDate ? <p class="work-date">{createdDate}</p> : null}
    {isPrivate ? <p class="work-private-note">守秘義務のため詳細は非公開</p> : null}
    {
      summary ? (
        <p class="work-summary">
          <Phrase text={summary} />
        </p>
      ) : null
    }
    {
      categories.length > 0 ? (
        <div class="work-categories">
          {categories.map((cat) => (
            <span class="work-category-tag">{cat.name}</span>
          ))}
        </div>
      ) : null
    }
  </div>
</Tag>

<style lang="sass">
  @use '../styles/spacing' as *
  // 一覧のグリッドの 2 行分（画像の段・文字の段）を使い、subgrid で同じ行のカードと段の高さをそろえる。
  // 画像は段の下端に置くので、縦横比やタイトルの行数が違っても、同じ行のカードで画像の下端がそろう
  .work-card
    overflow: hidden
    background-color: var(--c-white)
    display: grid
    grid-row: span 2
    grid-template-rows: subgrid
    row-gap: 0
    transition: background-color 0.3s ease

  :global([data-works-dark] .work-card)
    background-color: var(--c-black)

  .work-card--link
    text-decoration: none
    color: inherit

  // リンクのあるカードだけ、マウスを載せたときに画像を薄くしてタイトルに下線を引く
  .work-card--link .work-cover img
    transition: opacity 0.3s ease

  .work-card--link:hover .work-cover img
    opacity: 0.8

  .work-card--link:hover .work-card-title
    text-decoration: underline
    text-underline-offset: 0.2em

  .work-cover
    width: 100%
    align-self: end

    img
      width: 100%
      height: auto
      object-fit: contain

  .work-card-title
    margin: space(0) space(0) space(2) space(0)
    font-size: var(--type-body-size) !important
    font-family: var(--font-heading)
    font-weight: var(--type-h2-weight)
    color: var(--c-gray-800)
    transition: color 0.3s ease

  :global([data-works-dark] .work-card-title)
    color: var(--c-gray-200)

  // リンク先の印（タイトルの横に小さく出す）
  .work-card-title :global(.work-link-icon)
    display: inline-block
    vertical-align: -0.1em

  .visually-hidden
    position: absolute
    width: 1px
    height: 1px
    margin: -1px
    padding: 0
    overflow: hidden
    clip: rect(0 0 0 0)
    white-space: nowrap
    border: 0

  .work-date
    color: var(--c-gray-400)
    font-family: var(--font-latin)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    margin-top: space(1)
    transition: color 0.3s ease

  :global([data-works-dark] .work-date)
    color: var(--c-gray-200)

  .work-private-note
    color: var(--c-gray-400)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    margin-top: space(1)
    transition: color 0.3s ease

  :global([data-works-dark] .work-private-note)
    color: var(--c-gray-200)

  .work-summary
    color: var(--c-gray-800)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    margin-top: space(2)
    transition: color 0.3s ease

    @media (max-width: 768px)
      font-size: 0.8rem

  :global([data-works-dark] .work-summary)
    color: var(--c-gray-200)

  .work-categories
    display: flex
    flex-wrap: wrap
    gap: space(2)
    margin-top: space(3)

  /* 画像以外（テキストなど）のエリアの高さをそろえる */
  .work-content
    align-self: start

  .work-category-tag
    // 「Business Card」などがタグの中で改行されないようにする
    white-space: nowrap
    padding: space(1) space(2) space(1) space(2)
    border: 2px solid var(--c-gray-800)
    border-radius: 4px
    font-size: var(--type-body-size)
    font-family: var(--font-latin)
    // wave live には太字がないので、偽の太字にならないよう標準の太さにする
    font-weight: var(--type-body-weight)
    color: var(--c-gray-800)
    background: transparent
    transition: color 0.3s ease, border-color 0.3s ease

  :global([data-works-dark] .work-category-tag)
    color: var(--c-gray-200)
    border-color: var(--c-gray-200)
</style>
