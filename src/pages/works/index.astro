---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import WorkCard from '@/components/WorkCard.astro';
import { getNotionData } from '@/lib/notion';
import {
  compareByCreatedDateDesc,
  formatYearMonth,
  getCategories,
  getCreatedDate,
  getTitle,
  getWorkLink,
  isPrivate,
  localizeCover,
} from '@/lib/works';

// すべての作品を新しい順に並べる（Private も含めて表示する）
const { results } = await getNotionData();

// カバー画像を保存してサイト内のパスにする
// プライベート作品はサンプル画像を表示するため、カバー画像を取得・保存しない
const sortedWorks = await Promise.all(
  [...results]
    .sort(compareByCreatedDateDesc)
    .map(async (work) => ({ work, cover: isPrivate(work) ? '' : await localizeCover(work) })),
);

// 絞り込み用の全カテゴリ（重複を除いて名前順）
const uniqueCategories = [...new Set(results.flatMap((work) => getCategories(work).map((cat) => cat.name)))]
  .filter(Boolean)
  .sort();
---

<BaseLayout
  title="Works - dgdgdgdg"
  description="dgdgdgdgの制作実績一覧。デザイン・Web・映像・その他クリエイティブ作品をカテゴリ別に掲載。随時追加・更新しています。"
  keywords="works, portfolio, projects"
>
  <Fragment slot="head"> </Fragment>
  <Header />
  <main>
    <!-- Works data for client-side filtering/sorting -->
    <script define:vars={{ categoriesData: uniqueCategories }}>
      window.__CATEGORIES_DATA__ = categoriesData;
    </script>
    <div class="works-inner">
      <p class="works-note title">まだ掲載しきれていない作品もございます。随時、追加・更新してまいります。</p>
      <div class="works-grid" id="works-grid">
        {
          sortedWorks.map(({ work, cover }) => {
            const title = getTitle(work);
            const createdDate = getCreatedDate(work);
            const categories = getCategories(work);
            const link = getWorkLink(work);

            return (
              <WorkCard
                title={title}
                createdDate={formatYearMonth(createdDate)}
                categories={categories}
                coverImageUrl={cover}
                isPrivate={isPrivate(work)}
                href={link?.href}
                external={link?.external}
                dataWorkTitle={title}
                dataWorkDate={createdDate}
                dataWorkCategories={categories.map((cat) => cat.name).join(',')}
              />
            );
          })
        }
      </div>
    </div>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style lang="sass">
  @use '../../styles/spacing' as *
  main
    background-color: var(--c-white)
    margin: space(0)
    padding: space(0)
    transition: background-color 0.3s ease

  :global([data-works-dark]) main
    background-color: var(--c-black)

  .works-inner
    width: 100%
    max-width: 1200px
    margin: space(0) auto

  @media (max-width: 768px)
    .works-inner
      padding: space(0) space(4)

  .works-note
    margin: space(0) space(0) space(4) space(0)
    font-size: var(--type-body-size)
    color: var(--c-gray-400)
    line-height: var(--type-body-line)
    transition: color 0.3s ease

  :global([data-works-dark] .works-note)
    color: var(--c-gray-200)

  @media (max-width: 768px)
    .works-note
      margin-bottom: space(3)
      font-size: var(--type-caption-size)

  .works-grid
    display: grid
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr))
    gap: space(8) space(6)

  @media (max-width: 768px)
    .works-grid
      grid-template-columns: repeat(2, 1fr)
      gap: space(6) space(3)

  details
    margin-top: space(12)

    summary
      cursor: pointer
      padding: space(2)
      background: var(--c-white)
      border-radius: 4px

    pre
      margin-top: space(4)
      padding: space(4)
      background: var(--c-white)
      border-radius: 4px
      overflow-x: auto
      font-size: var(--type-caption-size)
</style>

<script>
  function updateWorks(
    sortSelect: HTMLSelectElement,
    filterSelect: HTMLSelectElement,
    categorySelect: HTMLSelectElement,
    worksGrid: HTMLElement,
  ) {
    const sortValue = sortSelect.value;
    const filterValue = filterSelect.value;
    const categoryValue = categorySelect.value;
    const cards = Array.from(worksGrid.querySelectorAll<HTMLElement>('.work-card'));

    // フィルタリング（表示/非表示を判定）
    const visibleCards: HTMLElement[] = [];
    const hiddenCards: HTMLElement[] = [];

    cards.forEach((card) => {
      const isPrivate = card.getAttribute('data-work-private') === 'true';
      const categories = card.getAttribute('data-work-categories') || '';
      const categoryList = categories ? categories.split(',').map((c) => c.trim()) : [];

      // 公開/プライベートフィルター
      let shouldShow = false;
      if (filterValue === 'public') {
        shouldShow = !isPrivate;
      } else if (filterValue === 'private') {
        shouldShow = isPrivate;
      } else {
        shouldShow = true; // 'all'
      }

      // カテゴリフィルター
      if (shouldShow && categoryValue !== 'all') {
        shouldShow = categoryList.includes(categoryValue);
      }

      if (shouldShow) {
        card.style.display = '';
        visibleCards.push(card);
      } else {
        card.style.display = 'none';
        hiddenCards.push(card);
      }
    });

    // 表示されているカードをソート
    visibleCards.sort((a, b) => {
      const dateA = a.getAttribute('data-work-date') || '';
      const dateB = b.getAttribute('data-work-date') || '';
      if (sortValue === 'date_desc') return dateB.localeCompare(dateA);
      if (sortValue === 'date_asc') return dateA.localeCompare(dateB);
      return 0;
    });

    // DOMの順序を更新（表示カードをソート順に、その後非表示カードを追加）
    visibleCards.forEach((card) => worksGrid.appendChild(card));
    hiddenCards.forEach((card) => worksGrid.appendChild(card));
  }

  function initWorksSortAndFilter() {
    // /works 以外のページでは何もしない
    const worksGrid = document.getElementById('works-grid');
    if (!worksGrid) return;

    const sortSelect = document.querySelector<HTMLSelectElement>('[data-works-sort]');
    const filterSelect = document.querySelector<HTMLSelectElement>('[data-works-filter]');
    const categorySelect = document.querySelector<HTMLSelectElement>('[data-works-category]');
    if (!sortSelect || !filterSelect || !categorySelect) return;

    // 並べ替え欄はヘッダーにあり、ページを移動するたびに作り直されるので、リスナーは重ならない
    const update = () => updateWorks(sortSelect, filterSelect, categorySelect, worksGrid);
    [sortSelect, filterSelect, categorySelect].forEach((select) => select.addEventListener('change', update));

    // 初期表示時にソートを実行
    update();
  }

  // 最初の読み込みと、View Transitions でのページ移動のたびに 1 回呼ばれる
  document.addEventListener('astro:page-load', initWorksSortAndFilter);
</script>
