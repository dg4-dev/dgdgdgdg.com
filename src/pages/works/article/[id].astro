---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { getNotionData, findPageByCustomId, getNotionPage, getNotionBlocksRecursive } from '@/lib/notion';
import { downloadAndSaveImage, isNotionUrl } from '@/lib/notion-images';
import { renderBlocks } from '@/lib/notion-render';

// 静的パス生成（空にして生成を停止）
export async function getStaticPaths() {
  const notionData = await getNotionData();
  // Privateがtrueのものは詳細ページを生成しない
  const publicPages = notionData.results.filter((page: any) => !page.properties?.Private?.checkbox);

  return publicPages.map((page: any) => ({
    params: { id: page.properties?.id?.rich_text?.[0]?.plain_text ?? page.id },
  }));
}

// URLパラメータからidを取得
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/works');
}

// UUID形式かどうかを判定（ハイフン付きUUID形式）
const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);

// UUIDの場合はそのまま使用、カスタムIDの場合は検索してUUIDを取得
let pageUuid: string;
if (isUuid) {
  pageUuid = id;
} else {
  const pageData: any = await findPageByCustomId(id);
  pageUuid = pageData.id;
}

// ページの詳細情報とブロックを取得（再帰的に子ブロックも含む・ページネーション対応）
const page: any = await getNotionPage(pageUuid);
const blocks: any[] = await getNotionBlocksRecursive(pageUuid);

// ブロック内の画像・動画をダウンロードしてローカルパスに差し替え
async function downloadBlockImages(blockList: any[]): Promise<void> {
  for (const block of blockList) {
    if (block.type === 'image') {
      const imageUrl = block.image?.type === 'file' ? block.image.file.url : block.image?.external?.url;
      if (imageUrl && isNotionUrl(imageUrl)) {
        const localPath = await downloadAndSaveImage(imageUrl);
        // ローカルパスを external として格納（renderBlock関数がexternal.urlを優先的に使用するため）
        block.image.external = { url: localPath };
        block.image.type = 'external';
      }
    }
    if (block.type === 'video') {
      const videoUrl = block.video?.type === 'file' ? block.video.file.url : block.video?.external?.url;
      if (videoUrl && isNotionUrl(videoUrl)) {
        const localPath = await downloadAndSaveImage(videoUrl);
        // ローカルパスを external として格納
        block.video.external = { url: localPath };
        block.video.type = 'external';
      }
    }
    if (block.children?.length) {
      await downloadBlockImages(block.children);
    }
  }
}

await downloadBlockImages(blocks);

// ブックマークブロックにOGメタデータ（タイトル・説明・画像・ファビコン）を付与
async function getBookmarkMeta(
  url: string,
): Promise<{ title?: string; description?: string; image?: string; logo?: string } | null> {
  try {
    const res = await fetch(`https://api.microlink.io?url=${encodeURIComponent(url)}`, {
      signal: AbortSignal.timeout(8000),
      headers: { Accept: 'application/json' },
    });
    if (!res.ok) return null;
    const json = await res.json();
    const d = json?.data;
    if (!d) return null;
    return {
      title: typeof d.title === 'string' ? d.title : undefined,
      description: typeof d.description === 'string' ? d.description : undefined,
      image: typeof d.image?.url === 'string' ? d.image.url : undefined,
      logo: typeof d.logo?.url === 'string' ? d.logo.url : undefined,
    };
  } catch {
    return null;
  }
}

async function enrichBlocksWithBookmarkMeta(blockList: any[]): Promise<void> {
  for (const block of blockList) {
    if (block.type === 'bookmark' && block.bookmark?.url) {
      block._og = await getBookmarkMeta(block.bookmark.url);
      try {
        const u = new URL(block.bookmark.url);
        block._favicon = block._og?.logo ?? `https://www.google.com/s2/favicons?domain=${u.hostname}&sz=64`;
      } catch {
        block._favicon = '';
      }
    }
    if (block.children?.length) await enrichBlocksWithBookmarkMeta(block.children);
  }
}

await enrichBlocksWithBookmarkMeta(blocks);

// 日付を年月のみにフォーマットする関数（表示用）
function formatDateToYearMonth(dateString: string): string {
  if (!dateString) return '';
  // YYYY-MM-DD形式からYYYY-MMに変換
  return dateString.substring(0, 7);
}

// プロパティからデータを抽出
const title = page.properties?.Title?.title?.[0]?.plain_text ?? 'No title';
const client = page.properties?.Client?.rich_text?.[0]?.plain_text ?? '';
const createdDateFull = page.properties?.['Created Date']?.date?.start ?? '';
const createdDate = formatDateToYearMonth(createdDateFull); // 表示用は年月のみ
const categories = page.properties?.Category?.multi_select ?? [];
const summary = page.properties?.Summary?.rich_text?.[0]?.plain_text ?? '';

// カバー画像を取得（Works一覧と同じロジック）
let coverImage = page.properties?.Cover?.files?.[0]?.file?.url ?? '';
if (coverImage && isNotionUrl(coverImage)) {
  const localPath = await downloadAndSaveImage(coverImage);
  if (localPath) coverImage = localPath;
}

// OGP 画像にはサイト内に保存したカバー画像を使う（Notion の URL は期限が切れるので使わない）
const ogImage = coverImage.startsWith('/') ? new URL(coverImage, Astro.site ?? Astro.url).href : undefined;
---

<BaseLayout
  title={`${title} - Works - dgdgdgdg`}
  description={summary || 'dgdgdgdgの制作実績記事です。'}
  keywords="works, portfolio, projects"
  ogImage={ogImage}
  ogType="article"
>
  <Fragment slot="head"> </Fragment>
  <Header />
  <main>
    <article class="work-detail">
      <header class="work-header">
        <h1>{title}</h1>
        {
          coverImage && (
            <div class="work-cover">
              <img src={coverImage} alt={title} loading="eager" />
            </div>
          )
        }
        <div class="work-meta">
          {
            client && (
              <div class="meta-item">
                <strong>Client:</strong> {client}
              </div>
            )
          }
          {
            createdDate && (
              <div class="meta-item">
                <strong>Created Date:</strong> {createdDate}
              </div>
            )
          }
          {
            categories.length > 0 && (
              <div class="meta-item meta-item--category">
                <strong>Category:</strong>
                <div class="categories">
                  {categories.map((cat: any) => (
                    <span class="category-tag">{cat.name}</span>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </header>
      {
        summary && (
          <div class="work-summary">
            <p>{summary}</p>
          </div>
        )
      }
      <div
        class="work-content"
        set:html={blocks.length > 0 ? renderBlocks(blocks) : '<p class="work-content-empty">本文はまだありません。</p>'}
      />
    </article>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style lang="sass">
  @use '../../../styles/spacing' as *
  main
    background-color: var(--c-white)
    margin: space(0)
    padding: space(0)
    transition: background-color 0.3s ease

  :global([data-works-dark]) main
    background-color: var(--c-black)

  .work-detail
    max-width: 900px
    margin: space(0) auto
    padding: space(0) space(0) space(16)

    @media (max-width: 768px)
      padding: space(0) space(4)

  .work-header
    margin-bottom: space(12)

    h1
      font-size: var(--type-h1-size)
      margin-bottom: space(6)
      color: var(--c-gray-925)
      transition: color 0.3s ease

  :global([data-works-dark] .work-header) h1
    color: var(--c-white)

  .meta-item
    margin: space(2) 0
    line-height: var(--type-body-line)
    color: var(--c-gray-400)
    transition: color 0.3s ease

    strong
      color: var(--c-gray-800)
      margin-right: space(2)
      transition: color 0.3s ease

  :global([data-works-dark] .meta-item)
    color: var(--c-white)

  :global([data-works-dark] .meta-item) strong
    color: var(--c-white)

  .meta-item--category
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: space(2)

    strong
      margin-right: space(0)

  .categories
    display: flex
    flex-wrap: wrap
    gap: space(2)

  .category-tag
    padding: space(1) space(2) space(1) space(2)
    border: 2px solid var(--c-gray-800)
    border-radius: 4px
    font-size: var(--type-body-size)
    font-family: var(--font-ui)
    font-weight: var(--type-h2-weight)
    color: var(--c-gray-800)
    background: transparent
    transition: color 0.3s ease, border-color 0.3s ease

  :global([data-works-dark] .category-tag)
    color: var(--c-white)
    border-color: var(--c-white)

  .work-cover
    width: 100%
    margin-bottom: space(12)

    img
      width: 100%
      max-height: 80vh
      height: auto
      object-fit: contain
      object-position: left
      display: block

  .work-summary
    margin-bottom: space(12)
    padding: space(6)
    background: var(--c-white)
    border-radius: 8px
    border-left: 4px solid var(--c-accent)
    transition: background-color 0.3s ease

    p
      margin: space(0)
      font-size: var(--type-body-size)
      line-height: var(--type-body-line)
      color: var(--c-gray-800)
      transition: color 0.3s ease

  :global([data-works-dark] .work-summary)
    background: var(--c-gray-900)
    p
      color: var(--c-white)

  .work-content
    line-height: var(--type-body-line)
    color: var(--c-gray-800)
    transition: color 0.3s ease

    :global(.work-content-empty)
      margin: space(4) 0
      color: var(--c-gray-400)
      font-size: var(--type-body-size)

    :global(h1),
    :global(h2),
    :global(h3)
      margin: space(8) 0 space(4)
      color: var(--c-gray-925)
      transition: color 0.3s ease

    :global(p)
      margin: space(4) 0

    :global(ul),
    :global(ol)
      margin: space(4) 0
      padding-left: space(8)

      // ネストされたリスト
      :global(ul),
      :global(ol)
        margin: space(1) 0

    :global(li)
      margin: space(2) 0

      // リストアイテム内のネストされたリスト
      > :global(ul),
      > :global(ol)
        margin-top: space(1)

    :global(.todo-list)
      list-style: none
      padding-left: space(0)

      // ネストされたTODOリスト
      :global(.todo-list)
        padding-left: space(8)
        margin: space(1) 0

      :global(.todo-item)
        :global(input[type='checkbox'])
          margin-right: space(2)
          vertical-align: middle

        // TODOアイテム内のネストされたリスト
        > :global(ul),
        > :global(ol),
        > :global(.todo-list)
          margin-top: space(1)
          padding-left: space(8)

    :global(.toggle-block)
      margin: space(4) 0
      padding: space(3)
      border: 1px solid var(--c-gray-200)
      border-radius: 4px

      :global(summary)
        cursor: pointer
        font-weight: var(--type-body-weight)
        user-select: none

        &:hover
          color: var(--c-accent)

    :global(.toggle-content)
      margin-top: space(2)
      padding-left: space(4)

    // 段落の下にインデントした子ブロック
    :global(.block-children)
      padding-left: space(6)

    // 段組み（スマホでは縦に並べる）
    :global(.columns)
      display: flex
      gap: space(8)
      margin: space(4) 0

      @media (max-width: 768px)
        flex-direction: column
        gap: space(0)

    :global(.column)
      flex-basis: 0
      min-width: 0

      @media (max-width: 768px)
        flex-basis: auto

    :global(blockquote)
      margin: space(6) 0
      padding: space(1) 0 space(1) space(4)
      border-left: 4px solid var(--c-gray-200)

    :global(.callout)
      display: flex
      gap: space(3)
      margin: space(6) 0
      padding: space(4)
      border: 1px solid var(--c-gray-200)
      border-radius: 4px

      :global(.callout-body)
        flex: 1
        min-width: 0

        > :global(:first-child)
          margin-top: space(0)

        > :global(:last-child)
          margin-bottom: space(0)

    // 表（幅が足りないときは横にスクロール）
    :global(.table-container)
      margin: space(6) 0
      overflow-x: auto

    :global(table)
      min-width: 100%
      border-collapse: collapse

    :global(th),
    :global(td)
      padding: space(2) space(3)
      border: 1px solid var(--c-gray-200)
      text-align: left
      vertical-align: top

    :global(th)
      font-weight: var(--type-h2-weight)

    :global(pre)
      margin: space(6) 0
      padding: space(4)
      background: var(--c-white)
      border-radius: 4px
      overflow-x: auto

      :global(code)
        font-family: 'Courier New', monospace
        font-size: var(--type-body-size)

    :global(code)
      background: var(--c-white)
      padding: space(1) space(1)
      border-radius: 3px
      font-family: 'Courier New', monospace

    :global(figure)
      margin: space(8) 0

      :global(img)
        width: 100%
        max-height: 80vh
        height: auto
        object-fit: contain
        object-position: left
        display: block

      :global(video)
        width: 100%
        max-width: 100%
        border-radius: 4px
        display: block

      :global(figcaption)
        text-align: center
        font-size: var(--type-body-size)
        line-height: var(--type-body-line)
        color: var(--c-gray-400)
        margin-top: space(2)

    :global(hr)
      margin: space(8) 0
      border: none
      border-top: 2px solid var(--c-gray-200)

    :global(a)
      color: var(--c-accent)
      text-decoration: none

      &:hover
        text-decoration: underline

    :global(.embed-container)
      position: relative
      width: 100%
      margin: space(8) 0
      padding-bottom: 56.25% // 16:9のアスペクト比
      height: 0
      overflow: hidden
      border-radius: 4px
      background: var(--c-white)

      :global(iframe)
        position: absolute
        top: 0
        left: 0
        width: 100%
        height: 100%
        border: none
        z-index: 1

      :global(.embed-fallback)
        position: absolute
        top: 0
        left: 0
        width: 100%
        height: 100%
        display: flex
        flex-direction: column
        align-items: center
        justify-content: center
        padding: space(8)
        text-align: center
        z-index: 0
        color: var(--c-gray-400)

        a
          margin-top: space(4)
          color: var(--c-accent)
          text-decoration: none

          &:hover
            text-decoration: underline

      // iframeが読み込まれたらフォールバックを非表示
      &:has(iframe[src]:not([src='']))
        :global(.embed-fallback)
          display: none

    // Twitter埋め込み用のスタイル
    :global(.embed-twitter)
      padding-bottom: space(0)
      height: auto
      min-height: 200px
      background: transparent

      :global(blockquote.twitter-tweet)
        margin: space(0)
        padding: space(4)
        border: 1px solid var(--c-gray-200)
        border-radius: 4px
        background: var(--c-white)

    // Bookmarkブロック用のスタイル（タイトル・説明・ファビコン・URL・OG画像のカード）
    :global(.bookmark-container)
      margin: space(8) 0

      :global(.bookmark-link)
        display: flex
        flex-direction: row
        align-items: stretch
        min-height: 160px
        padding: space(0)
        border: none
        border-radius: 12px
        background: var(--c-gray-800)
        text-decoration: none
        color: var(--c-white)
        transition: opacity 0.2s ease
        overflow: hidden

        &:hover
          opacity: 0.95

        :global(.bookmark-left)
          flex: 1
          min-width: 0
          padding: space(5) space(6)
          display: flex
          flex-direction: column
          justify-content: center
          gap: space(2)

        :global(.bookmark-title)
          font-size: var(--type-body-size)
          font-weight: var(--type-h2-weight)
          line-height: var(--type-body-line)
          color: var(--c-white)
          display: -webkit-box
          -webkit-line-clamp: 2
          -webkit-box-orient: vertical
          overflow: hidden

        :global(.bookmark-description)
          font-size: var(--type-body-size)
          font-weight: var(--type-body-weight)
          line-height: var(--type-body-line)
          color: var(--c-white-a90)
          display: -webkit-box
          -webkit-line-clamp: 2
          -webkit-box-orient: vertical
          overflow: hidden

        :global(.bookmark-meta)
          display: flex
          align-items: center
          gap: space(2)
          margin-top: space(1)

        :global(.bookmark-favicon)
          flex-shrink: 0
          width: 16px
          height: 16px
          border-radius: 2px

        :global(.bookmark-url)
          font-size: var(--type-caption-size)
          line-height: var(--type-caption-line)
          color: var(--c-white-a90)
          overflow: hidden
          text-overflow: ellipsis
          white-space: nowrap

        :global(.bookmark-right)
          flex: 0 0 42%
          max-width: 280px
          min-height: 160px
          background: var(--c-gray-925)

        :global(.bookmark-og-image)
          width: 100%
          height: 100%
          object-fit: cover
          display: block

  :global([data-works-dark] .work-content)
    color: var(--c-white)

  :global([data-works-dark] .work-content) :global(h1),
  :global([data-works-dark] .work-content) :global(h2),
  :global([data-works-dark] .work-content) :global(h3)
    color: var(--c-white)
</style>
