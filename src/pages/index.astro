---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import WorkCard from '@/components/WorkCard.astro';
import Phrase from '@/components/Phrase.astro';
import HeroBlueprint from '@/components/HeroBlueprint.astro';
import { getNotionData } from '@/lib/notion';
import { fontFaceCss, getTypefaces, variationSettings } from '@/lib/typefaces';
import {
  compareByCreatedDateDesc,
  formatYearMonth,
  getCategories,
  getCreatedDate,
  getSummary,
  getTitle,
  getWorkLink,
  isFeatured,
  isPrivate,
  localizeCover,
} from '@/lib/works';

// Featured の作品（プライベートも含める）を新しい順に最大 16 件
// 表示する作品のカバー画像だけを保存してサイト内のパスにし、カードのリンク先（詳細ページがあるか）を調べる
// プライベート作品は No Image の画像を表示するため、カバー画像を取得・保存しない
const { results } = await getNotionData();
const featuredWorks = await Promise.all(
  results
    .filter((work) => isFeatured(work))
    .sort(compareByCreatedDateDesc)
    .slice(0, 16)
    .map(async (work) => ({
      work,
      cover: isPrivate(work) ? '' : await localizeCover(work),
      link: await getWorkLink(work),
    })),
);

// Featured Works の上の帯に出す自作書体（新しい順）。GitHub から 1 つも取れなかったときは帯ごと出さない
const typefaces = await getTypefaces();
---

<BaseLayout
  title="dgdgdgdg"
  description="dgdgdgdg（だがし）のポートフォリオです。書体やグラフィックのデザイン、Webサイト、映像、音楽など、駄菓子のように色とりどりで、手に取った人がちょっと嬉しくなるものをつくっています。"
  keywords="portfolio, design, web"
>
  <Fragment slot="head">
    <!-- ページ固有の追加メタタグやスクリプトをここに記述可能 -->
    {typefaces.length > 0 && <style is:inline set:html={fontFaceCss(typefaces)} />}
  </Fragment>
  <Header />
  <main>
    <section class="hero is-instant" data-stage="0">
      {/* 何のサイトかを最初の画面で伝える。ヘッダーを隠している間だけ、ヘッダーの位置に出す */}
      <p class="hero-tagline"><span>デザイン・書体・Web をつくる、</span><span>dgdgdgdg のポートフォリオ</span></p>
      <div class="hero-content">
        <HeroBlueprint />
        <div class="scroll-indicator">
          <span class="scroll-text">SCROLL</span>
          <svg class="scroll-line" viewBox="0 0 1 60" xmlns="http://www.w3.org/2000/svg">
            <line class="scroll-rail" x1="0.5" y1="0" x2="0.5" y2="60" stroke="currentColor" stroke-width="1"></line>
            <line class="scroll-run" x1="0.5" y1="0" x2="0.5" y2="60" stroke="currentColor" stroke-width="1"></line>
          </svg>
        </div>
        {/* 設計図のアニメーション（段階 1〜8）の進み具合。左右の端に縦に出す */}
        <span class="hero-progress hero-progress--left" aria-hidden="true"></span>
        <span class="hero-progress hero-progress--right" aria-hidden="true"></span>
      </div>
    </section>
    {
      typefaces.length > 0 && (
        <a href="/typefaces" class="top-typefaces">
          <span class="top-typefaces-inner">
            <span class="top-typefaces-label">Typefaces</span>
            <span class="top-typefaces-list">
              {typefaces.map((t) => {
                const first = t.presets[0]?.coordinates ?? {};
                const last = t.presets[t.presets.length - 1]?.coordinates ?? first;
                return (
                  <span
                    style={{
                      fontFamily: `'${t.cssFamily}'`,
                      '--sample-from': variationSettings(first),
                      '--sample-to': variationSettings(last),
                    }}
                  >
                    {t.familyName}
                  </span>
                );
              })}
            </span>
            <span class="top-typefaces-more section-link">書体一覧を見る</span>
          </span>
        </a>
      )
    }
    <section class="featured-works">
      <h2>Featured Works</h2>
      <p><Phrase text="ピックアップした作品" /></p>
      <p class="section-link-wrapper">
        <a href="/works" class="section-link">作品一覧を見る</a>
      </p>
      {
        featuredWorks.length > 0 && (
          <div class="featured-grid">
            {featuredWorks.map(({ work, cover, link }) => (
              <WorkCard
                title={getTitle(work)}
                createdDate={formatYearMonth(getCreatedDate(work))}
                summary={getSummary(work)}
                categories={getCategories(work)}
                coverImageUrl={cover}
                isPrivate={isPrivate(work)}
                href={link?.href}
                external={link?.external}
              />
            ))}
          </div>
        )
      }
    </section>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style lang="sass">
  @use '../styles/spacing' as *
  main
    margin: space(0)
    padding: space(0)
    padding-top: space(0) !important

  .section-link-wrapper
    margin-top: space(6)

  .section-link
    display: inline-flex
    align-items: center
    gap: space(2)
    padding: space(2) space(4)
    border-radius: 999px
    border: 1px solid currentColor
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    letter-spacing: 0.06em
    text-decoration: none
    transition: background-color 0.2s ease, color 0.2s ease

    &::after
      // 矢印は飾りなので、読み上げでは読まない
      content: '→' / ''
      font-size: var(--type-caption-size)

  .featured-works .section-link
    color: var(--c-black)
    border-color: var(--c-black)

    &:hover
      background-color: var(--c-black)
      color: var(--c-white)

  // sticky の .hero-content に設計図を描き、段階はスクロールの位置で進める
  // 高さは、画面 1 つ分 + 最後の段階に入る位置（257vh）+ べた塗りを見せておく分（100vh）
  .hero
    background-color: var(--c-white)
    height: 457vh
    position: relative
    overflow: clip
    transition: background-color 0.5s

    // ロゴを塗るのと一緒に背景の色を変える（スマホでは全体に引いてから塗るので、その分遅らせる）
    // ロゴ（#00d4d4）とのコントラスト比が 5.6 になる暗いグレーにする（明るいグレーでは 1.4 に届かない）
    &[data-stage='8']
      background-color: var(--c-gray-800)

      @media (max-width: 768px)
        transition-delay: 0.8s

  // ヘッダーの位置（header の padding・枠線・header-bar の padding の分だけ下）にそろえる
  .hero-tagline
    position: fixed
    top: calc(#{space(4)} + 1px + #{space(3)})
    left: space(4)
    right: space(4)
    z-index: 20
    color: var(--c-gray-800)
    font-family: var(--font-ui)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    letter-spacing: 0.04em
    text-align: center
    pointer-events: none
    transition: opacity 0.4s ease

    // 幅が足りないときは「、」のあとで改行し、それ以外の場所では改行しない
    span
      display: inline-block

  // べた塗りの段階では、ヘッダーと入れ替えて消す
  .hero[data-stage='8'] .hero-tagline
    opacity: 0

  .hero-content
    position: sticky
    top: 0
    width: 100%
    height: 100vh
    height: 100svh
    display: flex
    align-items: center
    justify-content: center
    overflow: hidden

  // 設計図のアニメーションの進み具合（--hero-progress: 0〜1。スクリプトが決める）を、上から下へ伸ばす
  .hero-progress
    position: absolute
    top: 0
    bottom: 0
    width: 2px
    background-color: var(--c-black-a8)
    z-index: 20
    pointer-events: none

    &::after
      content: ''
      position: absolute
      inset: 0
      background-color: var(--c-gray-800)
      transform: scaleY(var(--hero-progress, 0))
      transform-origin: top
      transition: background-color 0.5s

  .hero-progress--left
    left: 0

  .hero-progress--right
    right: 0

  // スマホの慣性スクロールは止められないので、ヒーローの上端と各段階の位置にスクロールスナップの点を置き、
  // そこを越えずに止まるようにする（点はトップページのスクリプトが STAGE_POSITIONS_VH から作る）
  :global(html:has(.hero-snap))
    scroll-snap-type: y proximity

  :global(.hero-snap)
    position: absolute
    left: 0
    width: 1px
    height: 1px
    scroll-snap-align: start
    scroll-snap-stop: always
    pointer-events: none

  // べた塗りの段階（暗い背景）では、ロゴと同じ色にする
  .hero[data-stage='8'] .hero-progress
    background-color: var(--c-white-a8)

    &::after
      background-color: var(--c-accent)

  .scroll-indicator
    position: absolute
    bottom: space(8)
    left: 50%
    color: var(--c-gray-800)
    transform: translateX(-50%)
    display: flex
    flex-direction: column
    align-items: center
    gap: space(3)
    z-index: 20
    transition: opacity 0.3s ease

  .scroll-text
    color: var(--c-gray-800)
    font-family: var(--font-display)
    font-variation-settings: 'RNDS' 0, 'slnt' 0
    font-weight: var(--type-body-weight)
    font-style: normal
    font-synthesis: none
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    transform: translateY(1.2px)

  .scroll-line
    width: 1px
    height: 60px
    overflow: visible

  // 薄い補助線を常に出し、その上を短い線が下から上へ走る（読み進めると中身が上へ動くのと同じ向き）
  .scroll-rail
    opacity: 0.25

  // 16 の線と 60 のすき間をくり返す破線をずらし、線を下の端（60）から上の端の外（-16）まで動かす
  .scroll-run
    stroke-dasharray: 16 60
    animation: scroll-line-run 1.6s cubic-bezier(0.6, 0, 0.4, 1) infinite

  @keyframes scroll-line-run
    0%
      stroke-dashoffset: -60
    100%
      stroke-dashoffset: 16

  @media (prefers-reduced-motion: reduce)
    .hero,
    .hero-tagline
      transition: none
    .scroll-run
      display: none

  @media (max-width: 768px)
    .scroll-text
      font-variation-settings: 'RNDS' 0, 'slnt' 0
      font-style: normal

  // Hero と Featured Works の間に置く、自作書体へ案内する 1 行の帯。Hero のアニメーションと目を取り合わないよう動かさない
  // 帯全体を書体一覧へのリンクにする
  .top-typefaces
    display: block
    color: var(--c-black)
    text-decoration: none
    background-color: var(--c-white)
    border-bottom: 1px solid var(--c-black-a25)
    position: relative
    z-index: 1
    // 左右の余白と最大幅を Featured Works（左右 space(8)、作品の並びは最大 1200px）にそろえる
    padding: space(0) space(8)

  .top-typefaces-inner
    max-width: 1200px
    margin: space(0) auto
    padding: space(6) space(0)
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: space(8)

  .top-typefaces-label
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    letter-spacing: 0.06em
    font-family: var(--font-latin)
    color: var(--c-black-a60)

  .top-typefaces-list
    flex: 1
    display: flex
    flex-wrap: wrap
    gap: space(2) space(10)

    span
      font-size: clamp(2.25rem, 4.5vw, 3.5rem)
      line-height: 1.1
      font-variation-settings: var(--sample-from)
      font-synthesis: none
      transition: font-variation-settings 0.6s ease

  // 見た目は「作品一覧を見る」と同じボタンにする（リンクは帯全体のまま）
  .top-typefaces-more
    white-space: nowrap

  // 書体ページと同じく、カーソルを乗せると書体名を最後のスタイルへ形を変える
  .top-typefaces:hover,
  .top-typefaces:focus-visible
    .top-typefaces-list span
      font-variation-settings: var(--sample-to)

    .top-typefaces-more
      background-color: var(--c-black)
      color: var(--c-white)

  @media (prefers-reduced-motion: reduce)
    .top-typefaces-list span
      transition: none

  // スマホでは「Typefaces」「書体一覧を見る」を 1 行目に、書体名をその下に縦に並べる
  @media (max-width: 768px)
    .top-typefaces
      padding: space(0) space(4)

    .top-typefaces-inner
      padding: space(5) space(0)
      gap: space(3) space(6)

    .top-typefaces-list
      flex-basis: 100%
      order: 1
      flex-direction: column

  .featured-works
    background-color: var(--c-white)
    min-height: 100vh
    position: relative
    z-index: 1
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    padding: space(16) space(8)

    h2
      color: var(--c-black)
      font-size: var(--type-display-size)
      font-family: var(--font-heading)
      font-weight: var(--type-display-weight)
      line-height: var(--type-display-line)

    p
      color: var(--c-gray-400)
      font-size: var(--type-h3-size)
      line-height: var(--type-h3-line)
      margin-top: space(4)
      margin-bottom: space(8)

    .featured-grid
      width: 100%
      max-width: 1200px
      display: grid
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr))
      gap: space(6)

    @media (max-width: 768px)
      padding: space(16) space(4)

      .featured-grid
        grid-template-columns: repeat(2, 1fr)
        gap: space(3)
</style>

<script>
  let scrollController: AbortController | null = null;

  // 段階（0: 方眼だけ → 1〜7: 補助線・ロゴ・寸法・比 → 8: べた塗り）に入るスクロールの位置（vh）
  // 次の段階までのスクロールの量は、その段階の動きの長さに合わせる（1 秒あたり 28vh、短くても 13vh）
  //   1: 横の補助線 1.6 秒 → 45vh / 2: 縦の補助線 1.5 秒 → 42vh / 3: 45° の補助線 1.5 秒 → 42vh / 4: 輪郭 1.7 秒 → 48vh
  //   5: 斜線 0.45 秒 → 13vh / 6: 寸法 1.2 秒 → 34vh / 7: 5A 0.45 秒 → 13vh（動きの長さは HeroBlueprint.astro の CSS から）
  // 最後の段階のあとも、.hero の高さの残り（100vh）の間はべた塗りのロゴを見せておく
  // 段階は 1 段ずつ動かし、その段階のアニメーションが終わるまでスクロールを止める（左右のバーに進み具合を出す）
  const STAGE_POSITIONS_VH = [20, 65, 107, 149, 197, 210, 244, 257];
  const LAST_STAGE = STAGE_POSITIONS_VH.length;
  // 境目の近くで上下に小さく動かしたときに、進む・戻るがせわしなく入れ替わらないよう、戻るときは少し手前まで待つ
  const BACK_MARGIN_VH = 6;

  /** スクロールした量（vh）に合う段階。今の段階から戻るときだけ BACK_MARGIN_VH の分だけ手前で切り替える */
  function stageAt(scrolledVh: number, current: number): number {
    let stage = STAGE_POSITIONS_VH.filter((position) => scrolledVh >= position).length;
    if (stage < current && scrolledVh >= STAGE_POSITIONS_VH[current - 1] - BACK_MARGIN_VH) stage = current;
    return stage;
  }

  document.addEventListener('astro:page-load', () => {
    // 前のスクロールリスナーをクリーンアップ
    scrollController?.abort();
    scrollController = null;

    // ヘッダー非表示制御（べた塗りの段階まで）
    const headerInner = document.querySelector('.header-inner') as HTMLElement;

    const hero = document.querySelector<HTMLElement>('.hero');
    const scrollIndicator = document.querySelector<HTMLElement>('.scroll-indicator');
    if (!hero) return;

    scrollController = new AbortController();
    const { signal } = scrollController;
    let ticking = false;
    // 見せている段階
    let stage = -1;
    // 段階のアニメーションの間は、スクロールをこの位置（px）で止める。止めていないときは null
    let lockY: number | null = null;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /** 見せる段階を切り替える */
    const showStage = (shown: number) => {
      hero.dataset.stage = String(shown);
      // その段階まで進んだら is-s1〜is-s8 を付ける（設計図の見た目は HeroBlueprint.astro の CSS で切り替える）
      for (let i = 1; i <= LAST_STAGE; i++) hero.classList.toggle(`is-s${i}`, shown >= i);

      // ヘッダー表示制御: べた塗りの段階で表示し、タグラインと入れ替える（タグラインは CSS で消す）
      // 隠している間は inert を付け、見えないリンクやボタンに Tab で移動できないようにする
      if (headerInner) {
        if (shown >= LAST_STAGE) {
          headerInner.style.removeProperty('opacity');
          headerInner.style.removeProperty('pointer-events');
          headerInner.inert = false;
        } else {
          headerInner.style.opacity = '0';
          headerInner.style.pointerEvents = 'none';
          headerInner.inert = true;
        }
      }
    };

    /** 設計図のアニメーション全体（段階 1〜8）の進み具合（0〜1）を、左右のバーに出す */
    const setProgress = (value: number) => hero.style.setProperty('--hero-progress', value.toFixed(4));

    /** ヒーローの中の段階の位置（vh）を、ページの上からのスクロールの位置（px）にする */
    const scrollYOf = (positionVh: number) =>
      hero.getBoundingClientRect().top + window.scrollY + (positionVh / 100) * window.innerHeight;

    const holdScroll = () => {
      if (lockY !== null && Math.abs(window.scrollY - lockY) > 1) window.scrollTo({ top: lockY, behavior: 'instant' });
    };

    // ヒーローの中で動いている transition（Web Animations API で取り出す。SCROLL の線のような繰り返す animation は除く）
    const runningTransitions = () =>
      hero
        .getAnimations({ subtree: true })
        .filter((animation) => 'transitionProperty' in animation && animation.playState !== 'finished');
    /** transition が終わるまでの残り（ms。始まるまでの待ち時間も含む） */
    const remainingMs = (animation: Animation) => {
      const timing = animation.effect?.getComputedTiming();
      return timing ? Number(timing.endTime) - Number(timing.localTime ?? 0) : 0;
    };
    const nextFrame = () => new Promise((resolve) => requestAnimationFrame(resolve));

    // べた塗りへの入れ替えは、設計図の線・文字などがすべて描き終わってから始める
    // （スクロールを止めている間は描き終わっているが、止めない設定のときや、止める条件を変えたときのため）
    const sketch = hero.querySelector('.bp-sketch');
    const waitForDrawing = async () => {
      await nextFrame();
      const drawing = () =>
        sketch
          ? sketch
              .getAnimations({ subtree: true })
              .filter((animation) => 'transitionProperty' in animation && animation.playState !== 'finished')
          : [];
      for (let running = drawing(); running.length > 0; running = drawing()) {
        await Promise.allSettled(running.map((animation) => animation.finished));
      }
    };

    /**
     * 隣の段階（to）へ 1 段だけ動かす。アニメーションが終わるまでスクロールを holdY で止め、左右のバーを伸ばす（戻すときは縮める）。
     * 終わったら止めるのをやめ、スクロールの位置がまだ先（手前）を指していれば、続けて次の段階を動かす
     */
    const playStage = async (to: number, holdY: number) => {
      const from = stage;
      stage = to;
      lockY = holdY;
      holdScroll();
      if (to === LAST_STAGE) await waitForDrawing();
      showStage(to);

      // class を付け替えた直後は transition がまだ始まっていないので、次の描画まで待ってから取り出す
      await nextFrame();
      const total = Math.max(1, ...runningTransitions().map(remainingMs));
      for (let running = runningTransitions(); running.length > 0; running = runningTransitions()) {
        const done = 1 - Math.max(0, ...running.map(remainingMs)) / total;
        setProgress((to > from ? from + done : from - done) / LAST_STAGE);
        await nextFrame();
      }
      setProgress(to / LAST_STAGE);
      lockY = null;
      update();
    };

    const update = () => {
      // ヒーロー内でスクロールした量（vh）
      const scrolledVh = (Math.max(0, -hero.getBoundingClientRect().top) / window.innerHeight) * 100;

      // スクロールインジケーターのフェードアウト（最初の段階に入るまでに消す）
      if (scrollIndicator) {
        const indicatorOpacity = Math.min(1, Math.max(0, 1 - (scrolledVh - 5) / 15));
        scrollIndicator.style.opacity = String(indicatorOpacity);
      }

      // アニメーションの間は、スクロールバーを動かされたときなども元の位置に戻す
      if (lockY !== null) {
        holdScroll();
        return;
      }

      const target = stageAt(scrolledVh, Math.max(stage, 0));
      if (target === stage) return;

      // 読み込んだときと、動きを減らす設定のときは、止めずにその段階をそのまま出す（べた塗りは描き終わりを待つ）
      if (stage < 0 || reducedMotion.matches) {
        stage = target;
        setProgress(target / LAST_STAGE);
        if (target < LAST_STAGE) {
          showStage(target);
          return;
        }
        showStage(LAST_STAGE - 1);
        waitForDrawing().then(() => {
          if (stage === LAST_STAGE && lockY === null) showStage(LAST_STAGE);
        });
        return;
      }

      // 速くスクロールしても段階を飛ばさないよう、1 段ずつ動かす
      if (target > stage) playStage(stage + 1, holdYOf(stage + 1));
      else playStage(stage - 1, holdYOf(stage - 1));
    };

    /**
     * 段階 to を動かしている間にスクロールを止める位置（px）。その段階に入る位置（段階 0 はヒーローの上端）。
     * 戻るときもこの位置で止めるので、止める位置はいつもスクロールスナップの点と同じになる
     */
    const holdYOf = (to: number) => scrollYOf(to > 0 ? STAGE_POSITIONS_VH[to - 1] : 0);

    /**
     * スクロールしたあとの位置（nextY）が、次の段階に入る位置（戻るときは戻る境目）を越えるなら、その段階を返す。
     * 越えた画面を一度描いてから戻すとちらつくので、ホイールとキーボードは、越える前に入力を取り消してこの段階を動かす
     */
    const stageCrossedBy = (nextY: number) => {
      const y = window.scrollY;
      if (nextY > y && stage < LAST_STAGE) {
        const enter = scrollYOf(STAGE_POSITIONS_VH[stage]);
        if (y < enter && nextY >= enter) return stage + 1;
      }
      if (nextY < y && stage > 0) {
        const leave = scrollYOf(STAGE_POSITIONS_VH[stage - 1] - BACK_MARGIN_VH);
        if (y >= leave && nextY < leave) return stage - 1;
      }
      return null;
    };
    const stopBeforeCrossing = (event: Event, nextY: number) => {
      if (stage < 0 || reducedMotion.matches) return;
      const crossed = stageCrossedBy(nextY);
      if (crossed === null) return;
      event.preventDefault();
      playStage(crossed, holdYOf(crossed));
    };

    // アニメーションの間は、ホイール・タッチ・キーボードでのスクロールを受け付けない
    // 止めていない間も、ホイールとキーボードは次の段階の位置を越える前に止める（慣性スクロールはスクロールスナップで止める）
    const blockWhileLocked = (event: Event) => {
      if (lockY !== null) event.preventDefault();
    };
    window.addEventListener(
      'wheel',
      (event) => {
        if (lockY !== null) return event.preventDefault();
        // ctrl を押しながらのホイール（トラックパッドのピンチ）は拡大・縮小なので止めない
        if (event.ctrlKey) return;
        const unit =
          event.deltaMode === WheelEvent.DOM_DELTA_LINE
            ? 16
            : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
              ? window.innerHeight
              : 1;
        stopBeforeCrossing(event, window.scrollY + event.deltaY * unit);
      },
      { passive: false, signal },
    );
    window.addEventListener('touchmove', blockWhileLocked, { passive: false, signal });

    /** キーボードでスクロールしたあとの位置。スクロールしないキーなら null */
    const keyScrollTarget = (event: KeyboardEvent) => {
      const page = window.innerHeight * 0.875;
      switch (event.key) {
        case 'ArrowDown':
          return window.scrollY + 40;
        case 'ArrowUp':
          return window.scrollY - 40;
        case 'PageDown':
          return window.scrollY + page;
        case 'PageUp':
          return window.scrollY - page;
        case ' ':
          return window.scrollY + (event.shiftKey ? -page : page);
        case 'Home':
          return 0;
        case 'End':
          return document.documentElement.scrollHeight;
        default:
          return null;
      }
    };
    window.addEventListener(
      'keydown',
      (event) => {
        // ボタンやリンクなどにフォーカスがあるときのキーは、その操作のために残す
        const onPage = event.target === document.body || event.target === document.documentElement;
        const nextY = keyScrollTarget(event);
        if (!onPage || nextY === null) return;
        if (lockY !== null) return event.preventDefault();
        stopBeforeCrossing(event, nextY);
      },
      { signal },
    );

    // スクロールスナップの点（ヒーローの上端と各段階の位置）
    if (!hero.querySelector('.hero-snap')) {
      for (const positionVh of [0, ...STAGE_POSITIONS_VH]) {
        const point = document.createElement('span');
        point.className = 'hero-snap';
        point.setAttribute('aria-hidden', 'true');
        point.style.top = `${positionVh}vh`;
        hero.append(point);
      }
    }

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true, signal });

    // 設計図（ロゴの幅を本文の幅にそろえた svg）が、線が出ている間は画面の左右 16px の内側に収まるよう、縮める割合（--bp-fit）を決める
    // 収まるときは 1。べた塗りの段階では縮めない（HeroBlueprint.astro の .bp-fit）
    const blueprint = hero.querySelector<SVGSVGElement>('.blueprint');
    const heroContent = hero.querySelector<HTMLElement>('.hero-content');
    const fitBlueprint = () => {
      if (!blueprint || !heroContent) return;
      const fit = Math.min(1, (heroContent.clientWidth - 32) / blueprint.getBoundingClientRect().width);
      hero.style.setProperty('--bp-fit', fit.toFixed(4));
    };
    window.addEventListener('resize', fitBlueprint, { passive: true, signal });

    // 途中の位置で開き直したときや、戻るボタンで位置が戻ったときは、その段階の状態から動かさずに始める
    // HTML でも最初から is-instant を付けておき、このスクリプトが動くまでの間に設計図の transition が走らないようにする
    // （Safari では、読み込んだ直後に線や文字が一瞬すべて出てから消えることがあった）
    hero.classList.add('is-instant');
    fitBlueprint();
    update();
    requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.remove('is-instant')));
  });
</script>
