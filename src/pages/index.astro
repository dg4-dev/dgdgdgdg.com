---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import WorkCard from '@/components/WorkCard.astro';
import Phrase from '@/components/Phrase.astro';
import HeroBlueprint from '@/components/HeroBlueprint.astro';
import { getNotionData } from '@/lib/notion';
import {
  compareByCreatedDateDesc,
  formatYearMonth,
  getCategories,
  getCreatedDate,
  getSummary,
  getTitle,
  getWorkLink,
  isFeatured,
  isPrivate,
  localizeCover,
} from '@/lib/works';

// Featured の作品（プライベートも含める）を新しい順に最大 16 件
// 表示する作品のカバー画像だけを保存してサイト内のパスにし、カードのリンク先（詳細ページがあるか）を調べる
// プライベート作品は No Image の画像を表示するため、カバー画像を取得・保存しない
const { results } = await getNotionData();
const featuredWorks = await Promise.all(
  results
    .filter((work) => isFeatured(work))
    .sort(compareByCreatedDateDesc)
    .slice(0, 16)
    .map(async (work) => ({
      work,
      cover: isPrivate(work) ? '' : await localizeCover(work),
      link: await getWorkLink(work),
    })),
);
---

<BaseLayout
  title="dgdgdgdg"
  description="dgdgdgdg（だがし）のポートフォリオです。書体やグラフィックのデザイン、Webサイト、映像、音楽など、駄菓子のように色とりどりで、手に取った人がちょっと嬉しくなるものをつくっています。"
  keywords="portfolio, design, web"
>
  <Fragment slot="head">
    <!-- ページ固有の追加メタタグやスクリプトをここに記述可能 -->
  </Fragment>
  <Header />
  <main>
    <section class="hero" data-stage="0">
      {/* 何のサイトかを最初の画面で伝える。ヘッダーを隠している間だけ、ヘッダーの位置に出す */}
      <p class="hero-tagline"><span>デザイン・書体・Web をつくる、</span><span>dgdgdgdg のポートフォリオ</span></p>
      <div class="hero-content">
        <HeroBlueprint />
        <div class="scroll-indicator">
          <span class="scroll-text">SCROLL</span>
          <svg class="scroll-line" viewBox="0 0 1 60" xmlns="http://www.w3.org/2000/svg">
            <line x1="0.5" y1="0" x2="0.5" y2="60" stroke="currentColor" stroke-width="1"></line>
          </svg>
        </div>
      </div>
    </section>
    <section class="featured-works">
      <h2>Featured Works</h2>
      <p><Phrase text="ピックアップした作品" /></p>
      <p class="section-link-wrapper">
        <a href="/works" class="section-link">作品一覧を見る</a>
      </p>
      {
        featuredWorks.length > 0 && (
          <div class="featured-grid">
            {featuredWorks.map(({ work, cover, link }) => (
              <WorkCard
                title={getTitle(work)}
                createdDate={formatYearMonth(getCreatedDate(work))}
                summary={getSummary(work)}
                categories={getCategories(work)}
                coverImageUrl={cover}
                isPrivate={isPrivate(work)}
                href={link?.href}
                external={link?.external}
              />
            ))}
          </div>
        )
      }
    </section>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style lang="sass">
  @use '../styles/spacing' as *
  main
    margin: space(0)
    padding: space(0)
    padding-top: space(0) !important

  .section-link-wrapper
    margin-top: space(6)

  .section-link
    display: inline-flex
    align-items: center
    gap: space(2)
    padding: space(2) space(4)
    border-radius: 999px
    border: 1px solid currentColor
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    letter-spacing: 0.06em
    text-decoration: none
    transition: background-color 0.2s ease, color 0.2s ease

    &::after
      // 矢印は飾りなので、読み上げでは読まない
      content: '→' / ''
      font-size: var(--type-caption-size)

  .featured-works .section-link
    color: var(--c-black)
    border-color: var(--c-black)

    &:hover
      background-color: var(--c-black)
      color: var(--c-white)

  // sticky の .hero-content に設計図を描き、段階はスクロールの位置で進める
  // 高さは、画面 1 つ分 + 最後の段階に入る位置（265vh）+ べた塗りを見せておく分（100vh）
  .hero
    background-color: var(--c-white)
    height: 465vh
    position: relative
    overflow: clip
    transition: background-color 0.5s

    // ロゴを塗るのと一緒に背景の色を変える（スマホでは全体に引いてから塗るので、その分遅らせる）
    &[data-stage='8']
      background-color: var(--c-gray-200)

      @media (max-width: 768px)
        transition-delay: 0.8s

  // ヘッダーの位置（header の padding・枠線・header-bar の padding の分だけ下）にそろえる
  .hero-tagline
    position: fixed
    top: calc(#{space(4)} + 1px + #{space(3)})
    left: space(4)
    right: space(4)
    z-index: 20
    color: var(--c-gray-800)
    font-family: var(--font-ui)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    letter-spacing: 0.04em
    text-align: center
    pointer-events: none
    transition: opacity 0.4s ease

    // 幅が足りないときは「、」のあとで改行し、それ以外の場所では改行しない
    span
      display: inline-block

  // べた塗りの段階では、ヘッダーと入れ替えて消す
  .hero[data-stage='8'] .hero-tagline
    opacity: 0

  .hero-content
    position: sticky
    top: 0
    width: 100%
    height: 100vh
    height: 100svh
    display: flex
    align-items: center
    justify-content: center
    overflow: hidden

  .scroll-indicator
    position: absolute
    bottom: space(8)
    left: 50%
    color: var(--c-gray-800)
    transform: translateX(-50%)
    display: flex
    flex-direction: column
    align-items: center
    gap: space(3)
    z-index: 20
    transition: opacity 0.3s ease

  .scroll-text
    color: var(--c-gray-800)
    font-family: var(--font-display)
    font-variation-settings: 'RNDS' 0, 'slnt' 0
    font-weight: var(--type-body-weight)
    font-style: normal
    font-synthesis: none
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    transform: translateY(1.2px)

  .scroll-line
    width: 1px
    height: 60px
    overflow: visible
    line
      stroke-dasharray: 60 60
      animation: scroll-line-trim 2s ease-in-out infinite

  @keyframes scroll-line-trim
    0%
      stroke-dashoffset: 60
    50%
      stroke-dashoffset: 0
    100%
      stroke-dashoffset: -60

  @media (prefers-reduced-motion: reduce)
    .hero,
    .hero-tagline
      transition: none

  @media (max-width: 768px)
    .scroll-text
      font-variation-settings: 'RNDS' 0, 'slnt' 0
      font-style: normal

  .featured-works
    background-color: var(--c-white)
    min-height: 100vh
    position: relative
    z-index: 1
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    padding: space(16) space(8)

    h2
      color: var(--c-black)
      font-size: var(--type-display-size)
      font-family: var(--font-heading)
      font-weight: var(--type-display-weight)
      line-height: var(--type-display-line)

    p
      color: var(--c-gray-400)
      font-size: var(--type-h3-size)
      line-height: var(--type-h3-line)
      margin-top: space(4)
      margin-bottom: space(8)

    .featured-grid
      width: 100%
      max-width: 1200px
      display: grid
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr))
      gap: space(6)

    @media (max-width: 768px)
      padding: space(16) space(4)

      .featured-grid
        grid-template-columns: repeat(2, 1fr)
        gap: space(3)
</style>

<script>
  let scrollController: AbortController | null = null;

  // 段階（0: 方眼だけ → 1〜7: 補助線・ロゴ・寸法・比 → 8: べた塗り）に入るスクロールの位置（vh）
  // 最後の段階のあとも、.hero の高さの残り（100vh）の間はべた塗りのロゴを見せておく
  const STAGE_POSITIONS_VH = [20, 55, 90, 125, 160, 195, 230, 265];
  const LAST_STAGE = STAGE_POSITIONS_VH.length;
  // 境目の近くで上下に小さく動かしたときに、進む・戻るがせわしなく入れ替わらないよう、戻るときは少し手前まで待つ
  const BACK_MARGIN_VH = 6;

  /** スクロールした量（vh）に合う段階。今の段階から戻るときだけ BACK_MARGIN_VH の分だけ手前で切り替える */
  function stageAt(scrolledVh: number, current: number): number {
    let stage = STAGE_POSITIONS_VH.filter((position) => scrolledVh >= position).length;
    if (stage < current && scrolledVh >= STAGE_POSITIONS_VH[current - 1] - BACK_MARGIN_VH) stage = current;
    return stage;
  }

  document.addEventListener('astro:page-load', () => {
    // 前のスクロールリスナーをクリーンアップ
    scrollController?.abort();
    scrollController = null;

    // ヘッダー非表示制御（べた塗りの段階まで）
    const headerInner = document.querySelector('.header-inner') as HTMLElement;

    const hero = document.querySelector<HTMLElement>('.hero');
    const scrollIndicator = document.querySelector<HTMLElement>('.scroll-indicator');
    if (!hero) return;

    scrollController = new AbortController();
    let ticking = false;
    let stage = -1;

    const setStage = (next: number) => {
      if (next === stage) return;
      stage = next;
      hero.dataset.stage = String(next);
      // その段階まで進んだら is-s1〜is-s8 を付ける（設計図の見た目は HeroBlueprint.astro の CSS で切り替える）
      for (let i = 1; i <= LAST_STAGE; i++) hero.classList.toggle(`is-s${i}`, next >= i);

      // ヘッダー表示制御: べた塗りの段階で表示し、タグラインと入れ替える（タグラインは CSS で消す）
      // 隠している間は inert を付け、見えないリンクやボタンに Tab で移動できないようにする
      if (headerInner) {
        if (next >= LAST_STAGE) {
          headerInner.style.removeProperty('opacity');
          headerInner.style.removeProperty('pointer-events');
          headerInner.inert = false;
        } else {
          headerInner.style.opacity = '0';
          headerInner.style.pointerEvents = 'none';
          headerInner.inert = true;
        }
      }
    };

    const update = () => {
      // ヒーロー内でスクロールした量（vh）
      const scrolledVh = (Math.max(0, -hero.getBoundingClientRect().top) / window.innerHeight) * 100;

      setStage(stageAt(scrolledVh, Math.max(stage, 0)));

      // スクロールインジケーターのフェードアウト（最初の段階に入るまでに消す）
      if (scrollIndicator) {
        const indicatorOpacity = Math.min(1, Math.max(0, 1 - (scrolledVh - 5) / 15));
        scrollIndicator.style.opacity = String(indicatorOpacity);
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true, signal: scrollController.signal });

    // 途中の位置で開き直したときや、戻るボタンで位置が戻ったときは、その段階の状態から動かさずに始める
    hero.classList.add('is-instant');
    update();
    requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.remove('is-instant')));
  });
</script>
