---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import { fontFaceCss, getTypefaces, variationSettings } from '@/lib/typefaces';

const typefaces = await getTypefaces();
---

<BaseLayout
  title="Typefaces - dgdgdgdg"
  description="dgdgdgdgが制作した書体の一覧。可変軸を持つドット書体などを公開しています。"
  keywords="typefaces, fonts, variable font, dgdgdgdg"
>
  <Fragment slot="head">
    {typefaces.map((t) => <link rel="preload" href={t.fontUrl} as="font" crossorigin />)}
    <style is:inline set:html={fontFaceCss(typefaces)}></style>
  </Fragment>
  <Header />
  <main>
    <div class="typefaces-inner">
      <p class="typefaces-note">自作の書体です。フォントファイルは GitHub で公開しています。</p>
      {
        typefaces.length > 0 ? (
          <ul class="typeface-list">
            {typefaces.map((t) => {
              const first = t.presets[0]?.coordinates ?? {};
              const last = t.presets[t.presets.length - 1]?.coordinates ?? first;
              return (
                <li>
                  <a href={`/typefaces/${t.slug}`} class="typeface-row">
                    <div class="typeface-meta">
                      <h2 class="typeface-name">{t.familyName}</h2>
                      <p class="typeface-spec">
                        <span>{t.year}</span>
                        {t.axes.length > 0 && <span>Variable · {t.axes.length} axes</span>}
                        <span>{t.codepoints.length} glyphs</span>
                      </p>
                    </div>
                    <p
                      class="typeface-sample"
                      style={{
                        fontFamily: `'${t.cssFamily}'`,
                        '--sample-from': variationSettings(first),
                        '--sample-to': variationSettings(last),
                      }}
                    >
                      {t.sampleText}
                    </p>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="typefaces-empty">書体を読み込めませんでした。時間をおいて再度お試しください。</p>
        )
      }
    </div>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style lang="sass">
  @use '../../styles/spacing' as *
  main
    background-color: var(--c-black)
    color: var(--c-white)

  .typefaces-inner
    width: 100%
    max-width: 1200px
    margin: space(0) auto
    padding: space(8) space(0) space(16)

  @media (max-width: 1248px)
    .typefaces-inner
      padding-left: space(6)
      padding-right: space(6)

  @media (max-width: 768px)
    .typefaces-inner
      padding: space(6) space(4) space(12)

  .typefaces-note,
  .typefaces-empty
    margin-bottom: space(8)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    color: var(--c-white-a60)
    letter-spacing: 0.04em

  .typeface-list
    border-top: 1px solid var(--c-white-a30)

    li
      border-bottom: 1px solid var(--c-white-a30)

  .typeface-row
    display: flex
    flex-direction: column
    gap: space(6)
    padding: space(8) space(0) space(12)
    color: inherit
    text-decoration: none

  .typeface-meta
    display: flex
    align-items: baseline
    justify-content: space-between
    gap: space(4)
    flex-wrap: wrap

  .typeface-name
    font-family: var(--font-ui)
    font-size: var(--type-body-size) !important
    font-weight: var(--type-h2-weight)
    letter-spacing: 0.04em

  .typeface-spec
    display: flex
    gap: space(4)
    font-family: var(--font-ui)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    color: var(--c-white-a60)
    letter-spacing: 0.06em

  .typeface-sample
    font-size: clamp(4rem, 14vw, 12rem)
    line-height: 1.1
    font-variation-settings: var(--sample-from)
    font-synthesis: none
    white-space: nowrap
    overflow: hidden
    text-overflow: clip
    transition: font-variation-settings 0.6s ease, color 0.3s ease

  .typeface-row:hover .typeface-sample,
  .typeface-row:focus-visible .typeface-sample
    color: var(--c-accent)
    font-variation-settings: var(--sample-to)
</style>
