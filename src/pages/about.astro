---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import Phrase from '@/components/Phrase.astro';
import ContactCTA from '@/components/ContactCTA.astro';
---

<BaseLayout
  title="About - dgdgdgdg"
  description="dgdgdgdg（だがし）の紹介です。屋号の由来、活動内容、プロフィールを載せています。"
  keywords="about, dgdgdgdg"
>
  <Fragment slot="head"> </Fragment>
  <Header />
  <main>
    <section class="about-logo">
      <img src="/images/row.svg" alt="dgdgdgdg" width="566" height="151" />
    </section>

    <section class="about-intro">
      <h2 class="section-title">Concept</h2>
      <p class="section-subtitle">dgdgdgdgとは</p>
      <div class="intro-text">
        <p>
          <Phrase text="dgdgdgdgは私のハンドルネームであり、屋号でもあります。読み方は「だがし」です。" />
        </p>
        <p>
          <Phrase
            text="駄菓子屋に並ぶお菓子のように、小さくても色とりどりで、手に取った人がちょっと嬉しくなるようなものづくりをしたい——そんな思いを込めています。"
          />
        </p>
        <p>
          <Phrase
            text="書体やグラフィックのデザイン、Webサイトのコーディング、映像、音楽、3Dプリンターでつくる製品など、デジタルとアナログの両方でものづくりをしています。「深く掘り下げる（dig）」ことと「喜び（delight）」を届けることを大切にしながら、四季のように移り変わる好奇心のままに手を広げています。"
          />
        </p>
      </div>
    </section>

    <section class="about-activities">
      <h2 class="section-title">Activities</h2>
      <p class="section-subtitle">活動内容</p>
      <ul class="activity-tree">
        <li>
          Create
          <ul>
            <li>
              Design
              <ul>
                <li>Typeface</li>
                <li>Graphic</li>
                <li>Motion</li>
              </ul>
            </li>
            <li>3D Printed Product</li>
            <li>Website</li>
          </ul>
        </li>
        <li>Photography</li>
        <li>Electrical Work</li>
        <li>Other passing interests...</li>
      </ul>
    </section>

    <section class="about-profile">
      <h2 class="section-title">Profile</h2>
      <p class="section-subtitle">プロフィール</p>
      <div class="profile-content">
        <img src="/images/profile.webp" alt="dgdgdgdg" class="profile-image" width="160" height="160" />
        <dl class="profile-list">
          <div class="profile-row">
            <dt>名前</dt>
            <dd>Ren Yaegashi</dd>
          </div>
          <div class="profile-row">
            <dt>開始日</dt>
            <dd>2021 / 02 / 01</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>

<style lang="sass">
  @use '../styles/spacing' as *
  main
    background-color: var(--c-black)
    color: var(--c-white)
    min-height: 100vh
    padding: space(16) space(16) space(16)
    display: flex
    flex-direction: column
    align-items: center
    gap: space(16)

  .section-title
    color: var(--c-white)
    font-size: var(--type-h2-size)
    font-family: var(--font-heading)
    font-weight: var(--type-h2-weight)
    line-height: var(--type-h2-line)
    letter-spacing: 0.08em

  // 見出しは英語、補足の日本語をその下に小さく出す（トップの Featured Works と同じ形）
  .section-subtitle
    margin-top: space(1)
    margin-bottom: space(8)
    color: var(--c-gray-200)
    font-size: var(--type-caption-size)
    line-height: var(--type-caption-line)
    letter-spacing: 0.04em

  // Logo
  .about-logo
    padding-block: space(16)

    img
      display: block
      width: min(600px, 80vw)
      height: auto

  // Intro
  .about-intro
    width: 100%
    max-width: 720px

  .intro-text
    p
      font-size: var(--type-body-size)
      line-height: var(--type-body-line)
      letter-spacing: 0.04em
      &:not(:first-child)
        margin-top: space(6)

  // Activities
  .about-activities
    width: 100%
    max-width: 720px

  .activity-tree
    margin: space(0)
    padding: space(0)
    padding-left: space(6)

    ul
      margin: space(0)
      padding: space(0)
      padding-left: space(6)

    li
      font-size: var(--type-body-size)
      line-height: var(--type-body-line)
      letter-spacing: 0.04em
      padding: space(2) 0

  // Profile
  .about-profile
    width: 100%
    max-width: 720px

  .profile-content
    display: flex
    align-items: flex-start
    gap: space(8)

  .profile-image
    display: block
    width: 160px
    height: 160px
    border-radius: 50%
    object-fit: cover
    flex-shrink: 0

  .profile-list
    margin: space(0)
    flex: 1

  .profile-row
    display: flex
    align-items: baseline
    gap: space(8)
    padding: space(4) 0
    border-top: 1px solid var(--c-white-a8)
    &:last-child
      border-bottom: 1px solid var(--c-white-a8)

  dt
    color: var(--c-gray-200)
    font-size: var(--type-caption-size)
    font-family: var(--font-ui)
    font-weight: var(--type-body-weight)
    line-height: var(--type-caption-line)
    letter-spacing: 0.06em
    min-width: 72px
    flex-shrink: 0

  dd
    color: var(--c-white)
    font-size: var(--type-body-size)
    line-height: var(--type-body-line)
    letter-spacing: 0.04em

  @media (max-width: 768px)
    main
      padding: space(16) space(6) space(16)
      gap: space(16)

    .section-title
      font-size: var(--type-h3-size)

    .section-subtitle
      margin-bottom: space(6)

    .intro-text
      p
        font-size: var(--type-body-size)
        line-height: var(--type-body-line)
        &:not(:first-child)
          margin-top: space(5)

    .profile-row
      gap: space(6)

    dt
      font-size: var(--type-caption-size)
      min-width: 64px

    .profile-content
      flex-direction: column

    .profile-image
      width: 120px
      height: 120px

    dd
      font-size: var(--type-body-size)
</style>
